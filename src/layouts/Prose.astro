---
import Base from './Base.astro';

interface Props {
  title: string;
  eyebrow?: string;
  meta?: string[];
  description?: string;
}
const { title, eyebrow, meta = [], description } = Astro.props;
---

<Base title={title} description={description}>
  <main class="prose-page">
    <a class="back label" href="/">← back home</a>
    {eyebrow && <p class="eyebrow label">{eyebrow}</p>}
    <h1>{title}</h1>
    {meta.length > 0 && <p class="meta label">{meta.join(' · ')}</p>}
    <div class="prose">
      <slot />
    </div>
  </main>
</Base>

<style>
  .prose-page {
    padding: 34px var(--gutter) 60px;
    max-width: 760px;
    margin: 0 auto;
  }
  .back {
    display: inline-block;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    margin-bottom: 26px;
  }
  .eyebrow {
    margin: 0 0 8px;
    color: var(--blue);
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0 0 12px;
    overflow-wrap: anywhere;
  }
  .meta {
    margin: 0 0 28px;
    color: var(--ink-soft);
  }
  .prose {
    font-size: 1.02rem;
    line-height: 1.7;
    max-width: 65ch;
    min-width: 0;
    /* Hashes, paths and URLs in pentest notes are long unbroken strings. */
    overflow-wrap: anywhere;
  }
  .prose :global(h2) {
    font-family: var(--f-mono);
    font-size: 1.05rem;
    margin: 2.2em 0 0.6em;
  }
  .prose :global(h2)::before {
    content: '## ';
    color: var(--orange);
  }
  .prose :global(a) {
    color: var(--blue);
  }
  .prose :global(ul) {
    padding-left: 1.2em;
  }
  .prose :global(code:not(pre code)) {
    font-family: var(--f-mono);
    font-size: 0.88em;
    background: var(--white);
    border: 1px solid var(--rule);
    padding: 1px 5px;
    word-break: break-all;
  }
  /* Code blocks are dark terminal sheets taped onto the page. */
  .prose :global(pre) {
    position: relative;
    background-color: var(--term-bg) !important;
    color: var(--term-fg);
    font-family: var(--f-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    padding: 18px 16px;
    margin: 1.6em 0;
    overflow-x: auto;
    box-shadow: 0 8px 22px var(--shadow);
    max-width: 100%;
  }
  /* Screenshots get a white polaroid frame. */
  .prose :global(img) {
    display: block;
    background: var(--white);
    padding: 10px;
    box-shadow: 0 6px 18px var(--shadow);
    margin: 1.6em 0;
  }
</style>
