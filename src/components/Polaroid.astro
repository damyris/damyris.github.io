---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  caption: string;
  tilt: 'left' | 'right';
  image?: { src: ImageMetadata; alt: string };
  lines?: string[];
}
const { caption, tilt, image, lines } = Astro.props;
---

{
  (image || lines) && (
    <figure class:list={['polaroid', tilt]}>
      <span class:list={['tape', 'l', { blue: tilt === 'left' }]} />
      <span class:list={['tape', 'r', { blue: tilt === 'right' }]} />
      {image ? (
        <Image class="shot" src={image.src} alt={image.alt} widths={[240, 480]} sizes="200px" />
      ) : (
        <pre class="term" aria-label={`${caption}: ${lines!.join(' ')}`}>{lines!.join('\n')}</pre>
      )}
      <figcaption>{caption}</figcaption>
    </figure>
  )
}

<style>
  .polaroid {
    position: relative;
    margin: 0;
    background: var(--white);
    padding: 9px 9px 24px;
    box-shadow: 0 6px 18px var(--shadow);
    font-family: var(--f-hand);
    font-size: 0.95rem;
    text-align: center;
    max-width: 200px;
    width: 100%;
  }
  .left { transform: rotate(-3deg); }
  .right { transform: rotate(3deg); }
  .shot {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: left top;
    margin-bottom: 6px;
  }
  .term {
    margin: 0 0 6px;
    aspect-ratio: 4 / 5;
    background: var(--term-bg);
    color: var(--term-green);
    font-family: var(--f-mono);
    font-size: 10px;
    line-height: 1.6;
    text-align: left;
    padding: 12px;
    white-space: pre;
    overflow: hidden;
  }
</style>
