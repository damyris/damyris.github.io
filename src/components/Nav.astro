---
import { site } from '../config/site';

const path = Astro.url.pathname;
const isHome = path === '/';
const isLabs = path.startsWith('/writeups');
// On the home page, section links jump in place; elsewhere they go back home first.
const home = (hash: string) => (isHome ? hash : `/${hash}`);

const socials = [
  { key: 'github', href: site.socials.github, short: 'gh', label: 'GitHub', color: 'var(--yellow)' },
  { key: 'linkedin', href: site.socials.linkedin, short: 'in', label: 'LinkedIn', color: 'var(--pink)' },
  { key: 'tryhackme', href: site.socials.tryhackme, short: 'thm', label: 'TryHackMe', color: 'var(--green)' },
].filter((s) => Boolean(s.href));
---

<nav aria-label="Main">
  <div class="left">
    <a class="logo" href={home('#top')} aria-label={`${site.fullName}, home`}>&gt;_</a>
    <a href={home('#top')} class:list={[{ on: isHome }]}>Home</a>
    <a href={home('#about')}>About</a>
    <a href={home('#projects')}>Projects</a>
    <a href="/writeups/" class:list={[{ on: isLabs }]}>Labs</a>
  </div>
  <div class="right">
    {
      socials.map((s) => (
        <a
          class:list={['soc', s.key]}
          href={s.href}
          target="_blank"
          rel="noopener"
          aria-label={s.label}
          style={`--soc-bg: ${s.color}`}
        >
          {s.short}
        </a>
      ))
    }
    <a class="btn" href={site.resume} download>↓ Résumé</a>
    <a class="btn btn-ink" href="#contact">♥ Contact</a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 10px;
    padding: 8px 14px;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .left,
  .right {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  a {
    text-decoration: none;
    padding: 7px 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  a:hover {
    background: var(--sand);
  }
  a.on {
    background: var(--yellow);
  }
  .logo {
    width: 24px;
    height: 24px;
    padding: 0;
    justify-content: center;
    border-radius: 50%;
    background: var(--pink);
    color: var(--white);
    font-size: 10px;
    font-weight: 700;
    margin-right: 4px;
  }
  .logo:hover {
    background: var(--pink);
  }
  .soc {
    width: 26px;
    height: 26px;
    padding: 0;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--soc-bg);
    font-size: 9px;
    font-weight: 700;
    text-transform: lowercase;
  }
  .soc.tryhackme {
    color: var(--white);
  }
  .soc:hover {
    background: var(--soc-bg);
    transform: translateY(-1px);
  }
  .btn {
    border: 1.5px solid var(--ink);
    background: var(--white);
    margin-left: 4px;
  }
  .btn-ink {
    background: var(--ink);
    color: var(--white);
  }
  .btn-ink:hover {
    background: var(--ink);
  }
</style>
