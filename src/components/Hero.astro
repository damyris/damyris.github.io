---
import { site } from '../config/site';
const arrow =
  'M4 26 Q20 24 40 6 M40 6 L32 7 M40 6 L39 14';
---

<header class="hero" id="top">
  <div class="stage">
    <p class="hello hand">
      hello, i'm
      <svg width="40" height="8" viewBox="0 0 40 8" aria-hidden="true">
        <path d="M2 3 Q20 0 38 3 M5 6 Q20 4 35 6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
      </svg>
    </p>
    <div class="side l">
      <span class="pill mint">{site.pills[0]}</span>
      <span class="note yellow hand">
        {site.notes.left}
        <svg class="arrow" viewBox="0 0 46 30" aria-hidden="true">
          <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>
    <div class="namebox"><h1>{site.name}</h1></div>
    <div class="side r">
      <span class="pill sand">{site.pills[1]}</span>
      <span class="note mint hand">
        {site.notes.right}
        <svg class="arrow" viewBox="0 0 46 30" aria-hidden="true">
          <path d={arrow} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>
    <p class="status label"><i aria-hidden="true"></i> {site.status}</p>
  </div>

  <h2 class="headline">
    {site.headline.before}
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="10" fill="var(--green)"></circle>
      <circle cx="12" cy="12" r="6.5" fill="var(--white)"></circle>
      <circle cx="12" cy="12" r="3.5" fill="var(--ink)"></circle>
    </svg>
    {site.headline.after}
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7 11V8a5 5 0 0 1 10 0v3" fill="none" stroke="var(--ink)" stroke-width="2.2"></path>
      <rect x="4" y="11" width="16" height="11" rx="2" fill="var(--pink)"></rect>
      <circle cx="12" cy="16" r="1.8" fill="var(--white)"></circle>
    </svg>
  </h2>
  <a class="cta" href="#contact"><b aria-hidden="true">↗</b>Contact me</a>
  <svg class="curve" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 38 Q500 -10 1000 38" fill="none" stroke="var(--ink-soft)" stroke-width="1"></path>
  </svg>
</header>

<style>
  .hero {
    padding: 44px var(--gutter) 30px;
    text-align: center;
  }
  .stage {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px 22px;
    max-width: 780px;
    margin: 0 auto;
  }
  .hello {
    grid-column: 2;
    margin: 0;
    font-size: 1.1rem;
    line-height: 1;
  }
  .hello svg {
    display: block;
    margin: 3px auto 0;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 46px;
    align-items: flex-end;
    min-width: 0;
  }
  .side.r {
    align-items: flex-start;
  }
  .pill {
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    box-shadow: 0 2px 0 var(--shadow);
  }
  .note {
    position: relative;
    font-size: 1rem;
    line-height: 1.25;
    padding: 4px 12px;
    max-width: 16ch;
    box-shadow: 0 2px 0 var(--shadow);
  }
  .mint { background: var(--mint); }
  .sand { background: var(--sand); }
  .yellow { background: var(--yellow); }
  .arrow {
    position: absolute;
    width: 46px;
    height: 30px;
    top: -26px;
  }
  .l .arrow { right: -40px; }
  .r .arrow { left: -40px; transform: scaleX(-1); }
  .namebox {
    border: 2px solid var(--orange);
    border-radius: 4px;
    padding: 6px 22px 2px;
    transform: rotate(-0.6deg);
  }
  h1 {
    font-family: var(--f-pixel);
    font-weight: 700;
    font-size: clamp(2.3rem, 7.5vw, 5rem);
    line-height: 1;
    margin: 0;
    letter-spacing: 0.01em;
  }
  .status {
    grid-column: 1 / -1;
    margin: 4px 0 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
  }
  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
  }
  @media (max-width: 640px) {
    .stage { grid-template-columns: 1fr; }
    .hello { grid-column: 1; }
    .side {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px;
    }
    .side.r { align-items: center; }
    .arrow { display: none; }
    .note { max-width: none; }
    .side.l { order: 3; }
    .side.r { order: 4; }
    .status { order: 5; }
  }
  .headline {
    font-weight: 600;
    font-size: clamp(1.6rem, 4.4vw, 2.5rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 34px auto 22px;
    max-width: 18ch;
  }
  .headline svg {
    display: inline-block;
    vertical-align: -0.12em;
    width: 0.9em;
    height: 0.9em;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: var(--white);
    text-decoration: none;
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 14px 6px 6px;
  }
  .cta b {
    width: 22px;
    height: 22px;
    background: var(--blue);
    display: grid;
    place-items: center;
    font-size: 12px;
  }
  .curve {
    display: block;
    width: 100%;
    height: 40px;
    margin-top: 18px;
  }
</style>
